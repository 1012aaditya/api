# ---------------------------------------------------------------------------
# DocuParse — example environment. Copy to .env and fill in.
# Never commit .env. Every value below is a placeholder, not a real secret.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development            # development | staging | production
# Where the DASHBOARD is served, not the API. It is the base for invitation
# links and, in production, the one allowed CORS origin.
APP_URL=http://localhost:3000
# Only when the dashboard answers on more than one hostname. Comma separated.
# Development allows any origin regardless; production refuses a wildcard.
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
DEBUG=true

# --- Database (PostgreSQL) ---
# Async driver is required: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://docuparse:docuparse@localhost:5432/docuparse
# Connections held per process. Every API worker and every job worker keeps
# its own pool, so Postgres sees
#   (api workers + job workers) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# connections at once. Exceed max_connections and requests fail with "too
# many clients" under exactly the load you sized for. See DEPLOYMENT.md.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (rate limiting; async job queue in a later phase) ---
# Optional in development. REQUIRED under APP_ENV=production: the fallback
# limiter counts inside one process, so N API workers would grant every
# organization N times its limit. Production refuses to boot without it.
REDIS_URL=redis://localhost:6379/0
# The explicit "yes, I really do run a single worker" escape hatch.
ALLOW_IN_MEMORY_RATE_LIMIT=false

# --- Object storage for uploaded documents ---
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./backend/storage
STORAGE_BUCKET=docuparse-documents
S3_ENDPOINT_URL=               # e.g. https://s3.amazonaws.com, or a MinIO/R2 endpoint
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRY_SECONDS=900

# --- Extraction tiers (§34) ---
# Ordered, cheapest first. Each tier is a more direct way of reading the same
# document, and the router escalates only when what it has is not enough:
#
#   qr          the e-invoice QR — the IRP's own record. Free, ~5ms.
#   text_layer  labelled fields read straight out of a digital PDF. Free.
#   model       a vision model on the page images. The expensive one.
#
# Drop "model" and the deployment is fully local and model-free: documents the
# cheap tiers cannot read come back partially filled with the gaps reported,
# never guessed.
EXTRACTION_TIERS=qr,text_layer,model
# Line items are never produced by the qr or text_layer tiers. Leave this on
# and an invoice with a line-item table escalates to the model; turn it off
# when header-level data (numbers, dates, GSTINs, totals) is all you need.
EXTRACTION_REQUIRE_LINE_ITEMS=true

# --- AI provider ---
# The provider adapter is selected by name. "openai_compatible" speaks the
# OpenAI chat-completions wire format and works with vLLM, Ollama, OpenRouter,
# Together, LiteLLM, or the OpenAI API itself.
# If AI_API_KEY is empty the API returns 503 extraction_provider_unavailable.
# It never fabricates invoice data.
# "openai_compatible" also speaks to anything self-hosted that implements the
# same wire format — vLLM, Ollama, llama.cpp, LM Studio, LiteLLM. Point
# AI_BASE_URL at localhost and no document leaves your infrastructure.
#   AI_BASE_URL=http://localhost:8001/v1
#   AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
# Estimated cost accounting, in USD per 1M tokens. Used for usage reporting
# only — it is an estimate, not a bill from your provider.
AI_INPUT_COST_PER_MTOK=0
AI_OUTPUT_COST_PER_MTOK=0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-48-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Webhooks (§22) ---
# Per-endpoint signing secrets are DERIVED from this, never stored. That means
# no webhook secret sits in the database to leak — and that rotating this value
# rotates every endpoint's secret at once.
# Unset means webhooks cannot be created: an unsigned webhook is worse than
# none, because the receiver cannot tell our call from anyone else's.
WEBHOOK_SECRET=change-me-generate-a-random-32-byte-secret
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=10
# Consecutive failures before we stop calling a dead endpoint.
WEBHOOK_FAILURE_THRESHOLD=20
# Customer-supplied URLs are an SSRF vector. Leave these alone in production:
# together they are what stops "deliver my webhook to 169.254.169.254".
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_ALLOW_PRIVATE_URLS=false

# --- Async jobs and the worker (§6) ---
JOB_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
# A job claimed but never finished (worker killed mid-run) returns to the queue
# after this long.
JOB_STALE_AFTER_SECONDS=900

# --- Upload limits ---
MAX_FILE_SIZE_BYTES=20971520   # 20 MiB
MAX_PAGE_COUNT=25
# Files accepted in one bulk upload (POST /v1/batches). A cap, because the
# whole batch arrives as a single multipart body held in memory.
MAX_BATCH_FILES=200

# --- Data retention (§24) ---
# Stored document bytes are eligible for deletion after this many days.
# Set to 0 for "process and delete" — bytes are discarded once extraction ends.
DOCUMENT_RETENTION_DAYS=7

# --- Validation tuning ---
# Absolute currency tolerance when reconciling totals, in the invoice currency.
ROUNDING_TOLERANCE=1.0
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# --- Chasing clients for documents (the operations layer) ---
# Which WhatsApp adapter to build. "mock" records messages and sends nothing:
# right for development and the demo seed, refused outright when APP_ENV is
# production, because a dashboard that says "sent" about a message no phone
# received is worse than no messaging at all. "whatsapp_cloud" is Meta's
# WhatsApp Business Cloud API, and needs the four values below it.
WHATSAPP_PROVIDER=mock
# The sending number's id in the WhatsApp Business account, not the number.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent system-user token. Never logged and never returned by the API.
WHATSAPP_ACCESS_TOKEN=
# Meta only allows free-form text within 24 hours of the client's last
# message. Outside that window the first contact must be an approved template.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Shared with the provider, and checked on every inbound delivery. A webhook
# URL is public; without this, anything could post to it.
WHATSAPP_WEBHOOK_SECRET=
# Echoed back during the provider's one-time subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# Same rule as WhatsApp: "mock" places no calls and is refused in production.
# "exotel" places real calls through Exotel's Connect API.
VOICE_PROVIDER=mock
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# The ExoPhone the client sees as the caller, not anyone's mobile.
EXOTEL_CALLER_ID=
# The App (flow) that speaks when the client answers. Exotel plays a flow you
# build in their dashboard — this code cannot put words into the call, so THAT
# FLOW must open by saying it is an AI assistant calling on the firm's behalf.
EXOTEL_FLOW_ID=
# "in" for the Mumbai cluster, "sg" for Singapore.
EXOTEL_REGION=in

# --- Running the model on your own hardware (§19) ---
# Any OpenAI-compatible endpoint works, which includes a model on this very
# machine. With Ollama installed:
#
#   ollama serve && ollama pull qwen2.5:7b-instruct
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama        # Ollama ignores it; the client requires one
#   AI_MODEL=qwen2.5:7b-instruct
#
# A firm can then switch on "keep documents on your own hardware" in the
# dashboard, and any model that is not on this machine or this network is
# refused rather than used — extraction stops and waits for a person, and the
# agent falls back to its fixed schedule.

# --- Default org limits (overridable per organization in the database) ---
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_MONTHLY_DOCUMENT_QUOTA=1000

# ---------------------------------------------------------------------------
# Reserved. Not read by the current drivers — the storage and auth layers are
# self-hosted (S3-compatible + own JWT). Present so a Supabase-backed
# deployment can be wired up without changing the env contract.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
