# DocuParse — production environment.
#
#   cp .env.production.example deploy/.env
#   $EDITOR deploy/.env
#   cd deploy && docker compose -f docker-compose.prod.yml up -d --build
#
# Nothing here has a usable default for a credential. A missing secret makes
# the stack refuse to start; it never degrades to something that looks like
# it is working. If a value below is wrong, the note says what breaks.
#
# THIS FILE IS A TEMPLATE. The filled-in copy holds live credentials — keep
# it out of git (deploy/.env is already ignored), keep it 0600, and rotate
# anything that has ever been pasted into a chat window.

# --- Names --------------------------------------------------------------
# Both must already resolve to this machine before the first start, or
# Let's Encrypt fails the challenge and you get a certificate error.
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# Where the DASHBOARD lives — not the API. This is the base for invitation
# links and the allowed CORS origin. Point it at the API and invitations
# will 404 and the dashboard's every request will be blocked by the browser.
APP_URL=https://app.example.com
# Only if the dashboard answers on more than one hostname. Comma separated.
# A wildcard is refused under APP_ENV=production.
# CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com

LOG_LEVEL=INFO

# --- Secrets ------------------------------------------------------------
# Generate each one separately:  openssl rand -hex 32
# JWT_SECRET: changing it signs every open session out. WEBHOOK_SECRET:
# every per-endpoint signing key is derived from it, so changing it breaks
# every customer's webhook signature at once.
JWT_SECRET=
WEBHOOK_SECRET=
POSTGRES_PASSWORD=

# --- Capacity -----------------------------------------------------------
# The connection ceiling Postgres must survive is
#   (API_WORKERS + WORKER_REPLICAS) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# With the values below: (4 + 2) x (10 + 10) = 120, under max_connections.
# Raise the workers and you must raise POSTGRES_MAX_CONNECTIONS with them,
# or requests start failing with "too many clients" under exactly the load
# you sized for. DEPLOYMENT.md has the table.
API_WORKERS=4
WORKER_REPLICAS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
POSTGRES_MAX_CONNECTIONS=200
# Roughly 25% and 75% of the machine's RAM.
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB

BACKUP_KEEP_DAYS=14

# --- Documents ----------------------------------------------------------
# "local" keeps them on this machine's disk, which is right for one box.
# Move to "s3" before you run two — a document written on one machine is not
# on the other, and the download will 404 depending on which server answers.
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=docuparse-documents
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# How long a client's document is kept before it is purged. Shorter is a
# better promise to make to a CA; longer is friendlier when something needs
# re-reading.
DOCUMENT_RETENTION_DAYS=7

# --- Reading documents (AI) ---------------------------------------------
# Ollama runs inside this stack, so invoices never leave the machine. Pull
# the model once after the first start:
#   docker compose -f docker-compose.prod.yml exec ollama ollama pull qwen2.5vl:7b
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=local
AI_MODEL=qwen2.5vl:7b

# Most B2B invoices are digital PDFs the first two tiers read with no model
# at all. The model is the fallback, not the default path.
EXTRACTION_TIERS=qr,text_layer,model

# --- WhatsApp -----------------------------------------------------------
# WHATSAPP_PROVIDER=mock is REFUSED under APP_ENV=production: a deployment
# that believes it is messaging clients while sending nothing is worse than
# one that will not boot.
WHATSAPP_PROVIDER=whatsapp_cloud
# The number's id inside the WhatsApp Business account, not the number.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent system-user token. Never logged and never returned by the API.
WHATSAPP_ACCESS_TOKEN=
# You invent this; Meta echoes it back during the webhook handshake.
WHATSAPP_VERIFY_TOKEN=
# Your Meta app secret. Without it, anyone who learns the webhook URL can
# post fake client messages into a firm's timeline.
WHATSAPP_WEBHOOK_SECRET=
# Meta allows free-form text only within 24 hours of the client's last
# message. Outside that window the first contact must be this approved
# template — without it, the first chase to a silent client fails.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Voice --------------------------------------------------------------
# Off for every firm by default; a CA turns it on themselves. Leave the
# credentials blank and set VOICE_PROVIDER=exotel only once they are real.
# Exotel plays a flow you build in THEIR dashboard — this code cannot put
# words into the call, so that flow must open by saying it is an automated
# assistant calling on the firm's behalf.
VOICE_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your ExoPhone, not the CA's mobile.
EXOTEL_CALLER_ID=
EXOTEL_FLOW_ID=
EXOTEL_REGION=in
